{
  "name": "regxslayer",
  "version": "0.3.0",
  "description": "Terminal regex-practice game",
  "type": "module",
  "bin": {
    "regxslayer": "src/cli.tsx"
  },
  "scripts": {
    "dev": "bun run src/cli.tsx",
    "test": "bun test",
    "validate-content": "bun run scripts/validate-content.ts",
    "build": "bun build --compile src/cli.tsx --outfile dist/regxslayer",
    "build:full": "bun run scripts/validate-content.ts && bun build --compile src/cli.tsx --outfile dist/regxslayer",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gridland/bun": "latest",
    "@gridland/utils": "latest",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "typescript": "^5.4.0"
  }
}
